{
  "manifest_version": 3,
  "name": "MMDB 本机凭证助手",
  "version": "1.0.0",
  "description": "由用户点击后，将当前浏览器中 AI Studio 使用的 Cookie 导入已连接的本机 MMDB 账号管理。",
  "key": "",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://*.google.com/*", "http://127.0.0.1/*"],
  "externally_connectable": {"matches": ["http://127.0.0.1/*"]},
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "action": {"default_title": "MMDB 本机凭证助手", "default_popup": "connect.html"},
  "incognito": "not_allowed"
}
